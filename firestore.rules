rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Owner e-mails allowed to bootstrap themselves as admin (first sign-in).
    function isOwnerEmail() {
      return request.auth.token.email in ['kalis.martin@gmail.com'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function myRole() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isMember() && myRole() == 'admin';
    }

    function isAdult() {
      return isMember() && myRole() in ['admin', 'adult'];
    }

    match /members/{memberId} {
      // own doc is always readable (needed before role assignment)
      allow get: if isSignedIn() && request.auth.uid == memberId;
      allow read: if isMember();

      // owner bootstrap: become the first admin
      allow create: if isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.role == 'admin'
        && isOwnerEmail();

      // join via invite link: unassigned role + valid active invite token
      allow create: if isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.role == 'unassigned'
        && request.resource.data.inviteToken is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)).data.active == true;

      // members may update their own profile, notification tokens and shared
      // location — never their role
      allow update: if isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcmTokens', 'name', 'photoURL', 'location']);

      allow update, delete: if isAdmin();
    }

    match /invites/{token} {
      allow read, write: if isAdmin();
    }

    // family data: readable by every member, editable by admins
    match /kids/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /events/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /holidays/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /exceptions/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---------- pocket money (Banka) ----------

    // the kid record linked to the signed-in member (child accounts)
    function myKidId() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.kidId;
    }

    function isGuardianOf(kidId) {
      return isMember()
        && request.auth.uid in get(/databases/$(database)/documents/kids/$(kidId)).data.guardians;
    }

    // daily room-cleanliness verdicts, id = kidId_date
    match /choreDays/{dayId} {
      allow read: if isMember();
      // kid suggests their own day: suggestion fields only
      allow create: if isMember()
        && request.resource.data.kidId == myKidId()
        && dayId == request.resource.data.kidId + '_' + request.resource.data.date
        && request.resource.data.keys()
             .hasOnly(['kidId', 'date', 'suggestedAt', 'suggestedNote']);
      allow update: if isMember()
        && resource.data.kidId == myKidId()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['suggestedAt', 'suggestedNote']);
      // guardian judges (or re-judges) the day
      allow create: if isGuardianOf(request.resource.data.kidId)
        && dayId == request.resource.data.kidId + '_' + request.resource.data.date;
      allow update: if isGuardianOf(resource.data.kidId)
        && request.resource.data.kidId == resource.data.kidId
        && request.resource.data.date == resource.data.date;
      allow delete: if isAdmin();
    }

    // bonuses and cashouts
    match /pocket/{entryId} {
      allow read: if isMember();
      // adult adds a signed bonus with a label
      allow create: if isAdult()
        && request.resource.data.type == 'bonus'
        && request.resource.data.kidId is string
        && request.resource.data.amount is number
        && request.resource.data.label is string;
      // kid requests a payout of their own money
      allow create: if isMember()
        && request.resource.data.type == 'cashout'
        && request.resource.data.kidId == myKidId()
        && request.resource.data.status == 'requested'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      // guardian records a payout directly
      allow create: if isGuardianOf(request.resource.data.kidId)
        && request.resource.data.type == 'cashout'
        && request.resource.data.status == 'paid'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      // guardian pays a pending request
      allow update: if isGuardianOf(resource.data.kidId)
        && resource.data.type == 'cashout'
        && request.resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paidBy', 'paidByName', 'paidAt']);
      // dismiss a pending request: guardian, or the kid changing their mind
      allow delete: if resource.data.status == 'requested'
        && (isGuardianOf(resource.data.kidId) || resource.data.kidId == myKidId());
      allow delete: if isAdmin();
    }

    // pickup days: adults claim/confirm/note; children read-only
    match /days/{dayId} {
      allow read: if isMember();
      allow create, update: if isAdult()
        && request.resource.data.kidId is string
        && request.resource.data.date is string
        && dayId == request.resource.data.kidId + '_' + request.resource.data.date;
      allow delete: if isAdmin();
    }
  }
}

# Firebase web app config – Firebase console → Project settings → Your apps (Web)
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_STORAGE_BUCKET=
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FB_APP_ID=

# Web push key pair – Firebase console → Project settings → Cloud Messaging → Web push certificates
NEXT_PUBLIC_FB_VAPID_KEY=

# Set to 1 for local development against the Firebase Emulator Suite
NEXT_PUBLIC_USE_EMULATORS=
